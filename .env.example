# Copy to .env.local (gitignored) and fill in. All of these are server-side only.

# Qloo hackathon API key. Never expose it to the browser or commit it.
QLOO_API_KEY=

# Hackathon keys only work on this host; api.qloo.com and staging return 401 for them.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# live | mock. Defaults to live when QLOO_API_KEY is set, otherwise mock (synthetic fixtures).
QLOO_MODE=

# Optional: also cache Qloo responses on disk (handy for local dev and pre-warming demos).
# The directory is gitignored; cached Qloo data must never be committed.
QLOO_CACHE_DIR=

# Set to 1 to enable the /api/tools playground in a production build (off by default).
MISE_TOOL_PLAYGROUND=
