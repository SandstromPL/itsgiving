# Copy to .env.local (gitignored) and fill in. All of these are server-side only.

# Qloo hackathon API key. Never expose it to the browser or commit it.
QLOO_API_KEY=

# Hackathon keys only work on this host; api.qloo.com and staging return 401 for them.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# live | mock. Defaults to live when QLOO_API_KEY is set, otherwise mock (synthetic fixtures).
QLOO_MODE=

# Optional: also cache Qloo responses on disk (handy for local dev and pre-warming demos).
# The directory is gitignored; cached Qloo data must never be committed.
QLOO_CACHE_DIR=

# Set to 1 to enable the /api/tools playground in a production build (off by default).
MISE_TOOL_PLAYGROUND=

# --- LLM (free tiers only) ---
# The chain is gemini-3.5-flash-lite -> Groq openai/gpt-oss-120b -> gemini-3.8-flash -> labelled mock.
# Google AI Studio key (aistudio.google.com): used for the primary and last-resort models.
# Free-tier content may be used to improve Google's products, so Mise never sends personal data.
GEMINI_API_KEY=

# Groq key (console.groq.com): openai/gpt-oss-120b, second in the chain. Free tier is 8K tokens/minute.
GROQ_API_KEY=

# live | mock. Defaults to live when either LLM key is set, otherwise a labelled deterministic mock plans and writes.
LLM_MODE=

# Optional model overrides. GEMINI_MODEL goes first, GROQ_MODEL second, GEMINI_FALLBACK_MODEL last;
# set either Gemini one to "none" to drop it.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GROQ_MODEL=

# Real LLM calls allowed per UTC day per server instance (default 300); after that the labelled mock writes.
LLM_DAILY_CAP=

# Per-call timeout in milliseconds before falling through to the next provider (default 20000).
# A provider that times out, is overloaded (5xx) or rate limited is then skipped for 1-2 minutes.
LLM_TIMEOUT_MS=
