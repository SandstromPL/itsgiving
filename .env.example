# Copy to .env.local (gitignored) and fill in. All of these are server-side only.

# Qloo hackathon API key. Never expose it to the browser or commit it.
QLOO_API_KEY=

# Hackathon keys only work on this host; api.qloo.com and staging return 401 for them.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# live | mock. Defaults to live when QLOO_API_KEY is set, otherwise mock (synthetic fixtures).
QLOO_MODE=

# Optional: also cache Qloo responses on disk (handy for local dev and pre-warming demos).
# The directory is gitignored; cached Qloo data must never be committed.
QLOO_CACHE_DIR=

# Set to 1 to enable the /api/tools playground in a production build (off by default).
MISE_TOOL_PLAYGROUND=

# TMDB (themoviedb.org > Settings > API): the "API Read Access Token" (preferred) or the v3 "API Key". Only used to
# import a director's public TMDB list as their taste; pasting IMDb links works without it.
TMDB_API_KEY=

# --- LLM ---
# The chain is DeepSeek (paid, when its key is set) -> gemini-3.5-flash-lite -> Groq openai/gpt-oss-120b -> gemini-3.8-flash -> labelled mock.
# DeepSeek key (platform.deepseek.com). PAID, and first in the chain when set: it writes the best treatments for
# about $0.002 each. Leave empty to run on the free tiers only.
DEEPSEEK_API_KEY=

# Google AI Studio key (aistudio.google.com): the first free model (3.5 Flash-Lite) and the last resort (3.8 Flash).
# Free-tier content may be used to improve Google's products, so Mise never sends personal data.
GEMINI_API_KEY=

# Groq key (console.groq.com): openai/gpt-oss-120b, the second free model. Free tier is 8K tokens/minute.
GROQ_API_KEY=

# live | mock. Defaults to live when any LLM key is set, otherwise a labelled deterministic mock plans and writes.
LLM_MODE=

# Optional model overrides. DEEPSEEK_MODEL goes first (when its key is set), then GEMINI_MODEL, GROQ_MODEL and
# GEMINI_FALLBACK_MODEL last; set either Gemini one to "none" to drop it.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GROQ_MODEL=
DEEPSEEK_MODEL=

# Real LLM calls allowed per UTC day per server instance (default 300); after that the labelled mock writes.
LLM_DAILY_CAP=

# Per-call timeout in milliseconds for model calls that set none of their own (default 20000). Treatment steps set
# their own by thinking depth (TIMING in src/lib/agent/pipeline.ts). A provider that times out, is overloaded (5xx)
# or rate limited is then skipped for 1-2 minutes.
LLM_TIMEOUT_MS=
